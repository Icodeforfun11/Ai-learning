# ─── AI provider (server-side only; never prefix these with NEXT_PUBLIC_) ───
# Choose "anthropic" or "openai". Leave the key empty to run in clearly-labelled Demo Mode.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cost controls
AI_MAX_OUTPUT_TOKENS=2048        # hard cap per response
AI_RATE_LIMIT_PER_MINUTE=8       # per user/IP
AI_RATE_LIMIT_PER_DAY=150        # per user/IP
AI_REQUIRE_AUTH=false            # true = only signed-in Supabase users may call the AI

# ─── Supabase (optional: enables accounts + cloud sync). Without it, data stays in the browser. ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used server-side only to verify user tokens for AI_REQUIRE_AUTH (anon key is enough for getUser):
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── iOS app wrapper (Capacitor) ───
# Your deployed HTTPS URL, which the native iOS shell loads.
CAPACITOR_SERVER_URL=https://your-app.netlify.app
